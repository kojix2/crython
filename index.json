3b6e227f0ade30ea7e716ed6513d3a/src/crython/object.cr#L149"},"def":{"name":"inspect","args":[{"name":"io","external_name":"io","restriction":""}],"return_type":"Nil","visibility":"Public","body":"s = LibPython.object_repr(@raw)\nptr = LibPython.unicode_as_utf8(s)\nio.print(String.new(ptr))\n"}},{"html_id":"to_s(io):Nil-instance-method","name":"to_s","abstract":false,"args":[{"name":"io","external_name":"io","restriction":""}],"args_string":"(io) : Nil","args_html":"(io) : Nil","location":{"filename":"src/crython/object.cr","line_number":143,"url":"https://github.com/kojix2/crython/blob/da421e33fc3b6e227f0ade30ea7e716ed6513d3a/src/crython/object.cr#L143"},"def":{"name":"to_s","args":[{"name":"io","external_name":"io","restriction":""}],"return_type":"Nil","visibility":"Public","body":"s = LibPython.object_string(@raw)\nptr = LibPython.unicode_as_utf8(s)\nio.print(String.new(ptr))\n"}}],"macros":[{"html_id":"method_missing(call)-macro","name":"method_missing","abstract":false,"args":[{"name":"call","external_name":"call","restriction":""}],"args_string":"(call)","args_html":"(call)","location":{"filename":"src/crython/object.cr","line_number":48,"url":"https://github.com/kojix2/crython/blob/da421e33fc3b6e227f0ade30ea7e716ed6513d3a/src/crython/object.cr#L48"},"def":{"name":"method_missing","args":[{"name":"call","external_name":"call","restriction":""}],"visibility":"Public","body":"      def \n{{ call.name }}\n(\n        \n{% for arg in call.args %}\n        {{ arg }},\n      {% end %}\n\n      \n{% if call.named_args %}\n        {% for narg in call.named_args %}\n          {{ narg.name }},\n        {% end %}\n      {% end %}\n\n    )\n        attr = LibPython.object_get_attr_string(@raw, \n{{ call.name.stringify }}\n.to_unsafe)\n        \n{% if call.named_args %}\n          {% if call.args.size == 0 %}\n            args_tuple = LibPython.tuple_new(0)\n          {% else %}{% if call.args.size == 1 %}\n            args_tuple = LibPython.build_value(\"(O)\", {{ call.args.splat }})\n          {% else %}{% if call.args.size > 1 %}\n            args_tuple = LibPython.build_value(\"O\" * {{ call.args.size }}, {{ call.args.splat }})\n          {% end %}{% end %}{% end %}\n          kwargs_dict = LibPython.dict_new\n          {% for narg in call.named_args %}\n            str = {{ narg.name.stringify }}\n            cstr = str.to_unsafe\n            k = LibPython.unicode_from_string_and_size(cstr, str.size)\n            LibPython.dict_set_item(kwargs_dict, k, {{ narg.name }})\n          {% end %}\n          ret = LibPython.object_call(attr, args_tuple, kwargs_dict)\n        {% else %}\n          {% if call.args.size > 0 %}\n            ret = LibPython.object_call_function(attr, {{ call.args.splat }}, nil)\n          {% else %}\n            ret = LibPython.object_call_function(attr, nil)\n          {% end %}\n        {% end %}\n\n        PyObject.new(ret)\n      \nend\n    \n"}}]}]},{"html_id":"crython/Float32","path":"Float32.html","kind":"struct","full_name":"Float32","name":"Float32","abstract":false,"superclass":{"html_id":"crython/Float","kind":"struct","full_name":"Float","name":"Float"},"ancestors":[{"html_id":"crython/Float","kind":"struct","full_name":"Float","name":"Float"},{"html_id":"crython/Number","kind":"struct","full_name":"Number","name":"Number"},{"html_id":"crython/Steppable","kind":"module","full_name":"Steppable","name":"Steppable"},{"html_id":"crython/Comparable","kind":"module","full_name":"Comparable","name":"Comparable"},{"html_id":"crython/Value","kind":"struct","full_name":"Value","name":"Value"},{"html_id":"crython/Object","kind":"class","full_name":"Object","name":"Object"}],"locations":[{"filename":"src/crython/number.cr","line_number":61,"url":"https://github.com/kojix2/crython/blob/da421e33fc3b6e227f0ade30ea7e716ed6513d3a/src/crython/number.cr#L61"}],"repository_name":"crython","program":false,"enum":false,"alias":false,"const":false,"instance_methods":[{"html_id":"to_py-instance-method","name":"to_py","abs